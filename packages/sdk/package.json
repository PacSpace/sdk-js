{
  "name": "@pacspace-io/sdk",
  "version": "0.14.0",
  "description": "Official PacSpace Balance API SDK: TypeScript client for neutral usage-based billing verification and records, with the record check bundled",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./webhooks": {
      "types": "./dist/webhooks/index.d.ts",
      "default": "./dist/webhooks/index.js"
    },
    "./records-crypto": {
      "types": "./dist/records-crypto.d.ts",
      "default": "./dist/records-crypto.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "clean": "rm -rf dist",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "ethers": "^6.13.4"
  },
  "devDependencies": {
    "@pacspace/shared": "^1.0.0",
    "esbuild": "^0.25.11",
    "typescript": "^5.3.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "keywords": [
    "pacspace",
    "balance-api",
    "usage-based-billing",
    "billing-verification",
    "sdk"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PacSpace/sdk-js.git",
    "directory": "packages/sdk"
  },
  "publishConfig": {
    "access": "public"
  }
}
